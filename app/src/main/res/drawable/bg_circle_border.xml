<?xml version="1.0" encoding="utf-8"?>
<shape xmlns:android="http://schemas.android.com/apk/res/android"
    android:shape="rectangle">

    <!-- white background inside the rectangle -->
    <solid android:color="@android:color/white" />

    <!-- border/stroke using your primary color -->
    <stroke
        android:width="2dp"
        android:color="@color/color_primary" />

    <!-- rounded corners — change radius to 0dp for a sharp rectangle -->
    <corners android:radius="8dp" />

    <!-- size (controls the drawable intrinsic size) -->
    <size
        android:width="40dp"
        android:height="40dp" />
</shape>
