<?xml version="1.0" encoding="utf-8"?>
<shape xmlns:android="http://schemas.android.com/apk/res/android"
    android:shape="rectangle">

    <!-- Rounded corners -->
    <corners android:radius="20dp" />

    <!-- Background color (this will be overridden by backgroundTint in the layout) -->
    <solid android:color="#4CAF50" />

    <!-- Optional: Add padding inside the badge -->
    <padding
        android:left="12dp"
        android:top="6dp"
        android:right="12dp"
        android:bottom="6dp" />

</shape>