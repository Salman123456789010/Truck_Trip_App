    <string name="onboard_title_1">All trips in one place</string>
    <string name="onboard_desc_1">See all your trips with status, truck number and route. Open any trip to view full hisab of income, expenses and profit.</string>
    <string name="onboard_title_2">Add a new trip</string>
    <string name="onboard_desc_2">Tap Add Trip, enter From–To, truck number and start date. All income and expenses will be linked to this trip.</string>
    <string name="onboard_title_3">Add income (bhada / advance)</string>
    <string name="onboard_desc_3">Use Add Income to add bhada, extra income or advance. This increases your trip income and is used in final profit.</string>
    <string name="onboard_title_4">Add expenses and fuel correctly</string>
    <string name="onboard_desc_4">Use Add Expense for all trip kharcha: diesel, toll, food, driver, etc. While adding Fuel, fill amount for kharcha and litres + odometer for average.</string>
    <string name="onboard_title_5">Check trip profit and share PDF</string>
    <string name="onboard_desc_5">App automatically shows total income, total expense, profit/loss and fuel average (if data available). Generate and share PDF on WhatsApp.</string>
    <string name="onboard_title_6">Use in your own language</string>
    <string name="onboard_desc_6">Select your language from Profile. You can also open the How to Use screen anytime if you forget anything.</string>
