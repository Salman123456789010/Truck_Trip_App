<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="vertical"
    android:padding="@dimen/_16sdp"
    android:background="@color/white">

    <TextView
        android:id="@+id/title"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="@string/add_income"
        android:layout_marginStart="@dimen/_5sdp"
        android:textSize="@dimen/_18sdp"
        android:textStyle="bold"
        android:textColor="@color/black"
        android:paddingBottom="@dimen/_10sdp"
        android:fontFamily="@font/roboto_medium" />

    <!-- Total Income (भाड़ा) Field -->
<!--    <androidx.cardview.widget.CardView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="@dimen/_10sdp"
        app:cardCornerRadius="@dimen/_10sdp"
        app:cardElevation="@dimen/_2sdp"
        app:cardBackgroundColor="@color/white">

        <com.google.android.material.textfield.TextInputLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:padding="@dimen/_4sdp"
            app:boxStrokeColor="@color/color_primary"
            app:hintEnabled="true"
           >

            <com.google.android.material.textfield.TextInputEditText
                android:id="@+id/etTotalIncome"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:hint="@string/enter_income_amount"
                android:inputType="number"
                android:maxLength="9"
                android:textSize="@dimen/_14sdp" />

        </com.google.android.material.textfield.TextInputLayout>

    </androidx.cardview.widget.CardView>-->


    <com.google.android.material.card.MaterialCardView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginStart="@dimen/_5sdp"
        android:layout_marginTop="@dimen/_10sdp"
        android:layout_marginEnd="@dimen/_5sdp"
        app:cardBackgroundColor="@color/white"
        app:cardCornerRadius="@dimen/_5sdp"
        app:strokeColor="@color/grey"
        app:strokeWidth="@dimen/_1sdp">

        <LinearLayout
            android:id="@+id/amountLayout"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal">

            <com.google.android.material.textfield.TextInputEditText
                android:id="@+id/etTotalIncome"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:background="@null"
                android:fontFamily="sans-serif-condensed-medium"
                android:padding="@dimen/_10sdp"
                android:hint="@string/enter_income_amount"
                android:inputType="number"
                android:maxLength="9"
                android:textSize="@dimen/_14sdp" />

        </LinearLayout>

    </com.google.android.material.card.MaterialCardView>

    <!-- Advance Taken Field -->
    <androidx.cardview.widget.CardView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="@dimen/_10sdp"
        android:visibility="gone"
        app:cardCornerRadius="@dimen/_10sdp"
        app:cardElevation="@dimen/_2sdp"
        app:cardBackgroundColor="@color/white">

        <com.google.android.material.textfield.TextInputLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:padding="@dimen/_4sdp"
            app:boxStrokeColor="@color/color_primary"
            app:hintEnabled="true"
            style="@style/Widget.MaterialComponents.TextInputLayout.OutlinedBox">

            <com.google.android.material.textfield.TextInputEditText
                android:id="@+id/etAdvanceTaken"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:hint="Advance Taken"
                android:inputType="number"
                android:maxLength="9"
                android:textSize="@dimen/_14sdp" />

        </com.google.android.material.textfield.TextInputLayout>

    </androidx.cardview.widget.CardView>

    <!-- Balance Field (Auto-calculated, Read-only) -->
    <androidx.cardview.widget.CardView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="@dimen/_10sdp"
        android:visibility="gone"
        app:cardCornerRadius="@dimen/_10sdp"
        app:cardElevation="@dimen/_2sdp"
        app:cardBackgroundColor="@color/white">

        <com.google.android.material.textfield.TextInputLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:padding="@dimen/_4sdp"
            app:boxStrokeColor="@color/color_primary"
            app:hintEnabled="true"
            style="@style/Widget.MaterialComponents.TextInputLayout.OutlinedBox">

            <com.google.android.material.textfield.TextInputEditText
                android:id="@+id/etBalance"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:hint="Balance"
                android:inputType="number"
                android:focusable="false"
                android:clickable="false"
                android:enabled="false"
                android:textSize="@dimen/_14sdp" />

        </com.google.android.material.textfield.TextInputLayout>

    </androidx.cardview.widget.CardView>



    <com.google.android.material.card.MaterialCardView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginStart="@dimen/_5sdp"
        android:layout_marginTop="@dimen/_10sdp"
        android:layout_marginEnd="@dimen/_5sdp"
        app:cardBackgroundColor="@color/white"
        app:cardCornerRadius="@dimen/_5sdp"
        app:strokeColor="@color/black"
       >

        <LinearLayout
            android:id="@+id/datePicker"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal">

            <com.google.android.material.textfield.TextInputEditText
                android:id="@+id/etNote"
                android:layout_width="0dp"
                android:layout_weight="1.8"
                android:hint="@string/note_income_hint"
                android:inputType="textMultiLine"
                android:maxLines="3"
                android:textSize="@dimen/_14sdp"
                android:paddingHorizontal="@dimen/_5sdp"
                android:layout_height="wrap_content"
                android:background="@null"
                android:fontFamily="sans-serif-condensed-medium"
                android:padding="@dimen/_10sdp"
                android:textColor="@color/black"
              />
            <ImageView
                android:id="@+id/micNote"
                android:layout_width="@dimen/_20sdp"
                android:layout_height="@dimen/_20sdp"
                android:layout_alignParentEnd="true"
                android:layout_gravity="center"
                android:layout_centerVertical="true"
                android:layout_marginEnd="@dimen/_10sdp"
                android:contentDescription="Microphone"
                android:src="@drawable/baseline_mic_24"
                app:tint="@color/color_primary" />

        </LinearLayout>

    </com.google.android.material.card.MaterialCardView>

    <!-- Save Button -->
    <androidx.cardview.widget.CardView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="@dimen/_20sdp"
        android:layout_marginBottom="@dimen/_10sdp"
        app:cardBackgroundColor="@color/color_primary"
        app:cardCornerRadius="@dimen/_10sdp"
        app:cardElevation="@dimen/_2sdp">

        <TextView
            android:id="@+id/btnSave"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:fontFamily="@font/roboto_medium"
            android:padding="@dimen/_12sdp"
            android:gravity="center"
            android:textColor="@color/white"
            android:text="@string/save"
            android:textSize="@dimen/_16sdp" />

    </androidx.cardview.widget.CardView>

</LinearLayout>
