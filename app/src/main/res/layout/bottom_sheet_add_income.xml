<?xml version="1.0" encoding="utf-8"?>
<androidx.core.widget.NestedScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:fillViewport="true"
    android:id="@+id/design_bottom_sheet"
    android:scrollbars="none">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:paddingStart="@dimen/_12sdp"
        android:paddingEnd="@dimen/_12sdp"
        android:paddingTop="@dimen/_8sdp"
        android:paddingBottom="@dimen/_16sdp"
        android:background="@color/white">

        <!-- Title with Mic Button - More Compact -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center_vertical"
            android:paddingBottom="@dimen/_6sdp">

            <TextView
                android:id="@+id/title"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:text="@string/add_income"
                android:textSize="@dimen/_16sdp"
                android:textStyle="bold"
                android:textColor="@color/black"
                android:fontFamily="@font/roboto_medium" />

            <ImageView
                android:id="@+id/micTitleInstruction"
                android:layout_width="@dimen/_22sdp"
                android:layout_height="@dimen/_22sdp"
                android:contentDescription="Voice Instruction"
                android:src="@drawable/loud_speaker"
                android:padding="@dimen/_2sdp"
                app:tint="@color/color_primary" />

        </LinearLayout>

        <!-- Income Category Dropdown - Compact -->
        <com.google.android.material.card.MaterialCardView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/_6sdp"
            app:cardBackgroundColor="@color/white"
            app:cardCornerRadius="@dimen/_5sdp"
            app:strokeColor="@color/grey"
            app:strokeWidth="@dimen/_1sdp"
            app:cardElevation="0dp">

            <androidx.appcompat.widget.AppCompatSpinner
                android:id="@+id/spinnerIncomeCategory"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:padding="@dimen/_8sdp"
                android:spinnerMode="dropdown"
                android:background="@null" />

        </com.google.android.material.card.MaterialCardView>

        <!-- Total Income Amount Field - Compact -->
        <com.google.android.material.card.MaterialCardView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/_6sdp"
            app:cardBackgroundColor="@color/white"
            app:cardCornerRadius="@dimen/_5sdp"
            app:strokeColor="@color/grey"
            app:strokeWidth="@dimen/_1sdp"
            app:cardElevation="0dp">

            <com.google.android.material.textfield.TextInputEditText
                android:id="@+id/etTotalIncome"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:background="@null"
                android:fontFamily="sans-serif-condensed-medium"
                android:padding="@dimen/_8sdp"
                android:hint="@string/enter_income_amount"
                android:inputType="number"
                android:maxLength="9"
                android:imeOptions="actionNext"
                android:textSize="@dimen/_13sdp" />

        </com.google.android.material.card.MaterialCardView>

        <!-- Note Field - Compact with Mic -->
        <com.google.android.material.card.MaterialCardView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/_6sdp"
            app:cardBackgroundColor="@color/white"
            app:cardCornerRadius="@dimen/_5sdp"
            app:strokeColor="@color/black"
            app:cardElevation="0dp">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:gravity="center_vertical">

                <com.google.android.material.textfield.TextInputEditText
                    android:id="@+id/etNote"
                    android:layout_width="0dp"
                    android:layout_weight="1"
                    android:hint="@string/note_income_hint"
                    android:inputType="textCapSentences"
                    android:maxLines="2"
                    android:imeOptions="actionNext"
                    android:textSize="@dimen/_13sdp"
                    android:layout_height="wrap_content"
                    android:background="@null"
                    android:fontFamily="sans-serif-condensed-medium"
                    android:padding="@dimen/_8sdp"
                    android:textColor="@color/black" />

                <ImageView
                    android:id="@+id/micNote"
                    android:layout_width="@dimen/_20sdp"
                    android:layout_height="@dimen/_20sdp"
                    android:layout_marginEnd="@dimen/_8sdp"
                    android:contentDescription="Microphone"
                    android:src="@drawable/baseline_mic_24"
                    app:tint="@color/color_primary" />

            </LinearLayout>

        </com.google.android.material.card.MaterialCardView>

        <!-- Place Field - Compact with Mic -->
        <com.google.android.material.card.MaterialCardView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/_6sdp"
            app:cardBackgroundColor="@color/white"
            app:cardCornerRadius="@dimen/_5sdp"
            app:strokeColor="@color/black"
            app:cardElevation="0dp">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:gravity="center_vertical">

                <com.google.android.material.textfield.TextInputEditText
                    android:id="@+id/etPlace"
                    android:layout_width="0dp"
                    android:layout_weight="1"
                    android:hint="@string/place_city"
                    android:inputType="textCapWords"
                    android:maxLines="1"
                    android:imeOptions="actionDone"
                    android:textSize="@dimen/_13sdp"
                    android:layout_height="wrap_content"
                    android:background="@null"
                    android:fontFamily="sans-serif-condensed-medium"
                    android:padding="@dimen/_8sdp"
                    android:textColor="@color/black" />

                <ImageView
                    android:id="@+id/micPlace"
                    android:layout_width="@dimen/_20sdp"
                    android:layout_height="@dimen/_20sdp"
                    android:layout_marginEnd="@dimen/_8sdp"
                    android:contentDescription="Microphone"
                    android:src="@drawable/baseline_mic_24"
                    app:tint="@color/color_primary" />

            </LinearLayout>

        </com.google.android.material.card.MaterialCardView>

        <!-- Date Field - Compact -->
        <com.google.android.material.card.MaterialCardView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/_6sdp"
            app:cardBackgroundColor="@color/white"
            app:cardCornerRadius="@dimen/_5sdp"
            app:strokeColor="@color/grey"
            app:strokeWidth="@dimen/_1sdp"
            app:cardElevation="0dp">

            <com.google.android.material.textfield.TextInputEditText
                android:id="@+id/etDate"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:background="@null"
                android:fontFamily="sans-serif-condensed-medium"
                android:padding="@dimen/_8sdp"
                android:hint="@string/date"
                android:inputType="none"
                android:focusable="false"
                android:clickable="true"
                android:drawableEnd="@android:drawable/ic_menu_my_calendar"
                android:drawableTint="@color/color_primary"
                android:textSize="@dimen/_13sdp" />

        </com.google.android.material.card.MaterialCardView>

        <!-- Advance Taken Field - Hidden by default -->
        <androidx.cardview.widget.CardView
            android:id="@+id/cvAdvanceTaken"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/_6sdp"
            android:visibility="gone"
            app:cardCornerRadius="@dimen/_5sdp"
            app:cardElevation="0dp"
            app:cardBackgroundColor="@color/white">

            <com.google.android.material.textfield.TextInputLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:padding="@dimen/_2sdp"
                app:boxStrokeColor="@color/color_primary"
                app:hintEnabled="true"
                style="@style/Widget.MaterialComponents.TextInputLayout.OutlinedBox">

                <com.google.android.material.textfield.TextInputEditText
                    android:id="@+id/etAdvanceTaken"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:hint="Advance Taken"
                    android:inputType="number"
                    android:maxLength="9"
                    android:imeOptions="actionNext"
                    android:textSize="@dimen/_13sdp" />

            </com.google.android.material.textfield.TextInputLayout>

        </androidx.cardview.widget.CardView>

        <!-- Balance Field - Hidden by default -->
        <androidx.cardview.widget.CardView
            android:id="@+id/cvBalance"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/_6sdp"
            android:visibility="gone"
            app:cardCornerRadius="@dimen/_5sdp"
            app:cardElevation="0dp"
            app:cardBackgroundColor="@color/white">

            <com.google.android.material.textfield.TextInputLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:padding="@dimen/_2sdp"
                app:boxStrokeColor="@color/color_primary"
                app:hintEnabled="true"
                style="@style/Widget.MaterialComponents.TextInputLayout.OutlinedBox">

                <com.google.android.material.textfield.TextInputEditText
                    android:id="@+id/etBalance"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:hint="Balance"
                    android:inputType="number"
                    android:focusable="false"
                    android:clickable="false"
                    android:enabled="false"
                    android:textSize="@dimen/_13sdp" />

            </com.google.android.material.textfield.TextInputLayout>

        </androidx.cardview.widget.CardView>

        <!-- Save Button - Compact -->
        <androidx.cardview.widget.CardView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/_12sdp"
            app:cardBackgroundColor="@color/color_primary"
            app:cardCornerRadius="@dimen/_8sdp"
            app:cardElevation="@dimen/_2sdp">

            <TextView
                android:id="@+id/btnSave"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:fontFamily="@font/roboto_medium"
                android:padding="@dimen/_10sdp"
                android:gravity="center"
                android:textColor="@color/white"
                android:text="@string/save"
                android:textSize="@dimen/_15sdp" />

        </androidx.cardview.widget.CardView>

    </LinearLayout>

</androidx.core.widget.NestedScrollView>