<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/surface_app_bg"
    android:orientation="vertical">

    <!-- Top App Bar -->
    <androidx.appcompat.widget.Toolbar
        android:id="@+id/toolbar"
        android:layout_width="match_parent"
        android:layout_height="?attr/actionBarSize"
        android:background="@color/color_primary"
        app:contentInsetStart="0dp">

        <RelativeLayout
            android:layout_width="match_parent"
            android:layout_height="match_parent">

            <ImageView
                android:id="@+id/btnBack"
                android:layout_width="38dp"
                android:layout_height="38dp"
                android:layout_centerVertical="true"
                android:layout_marginStart="8dp"
                android:background="?attr/selectableItemBackgroundBorderless"
                android:clickable="true"
                android:focusable="true"
                android:padding="8dp"
                android:src="@drawable/baseline_arrow_back_24"
                app:tint="@color/white" />

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_centerVertical="true"
                android:layout_toEndOf="@+id/btnBack"
                android:layout_toStartOf="@+id/btnInfoDialog"
                android:layout_marginEnd="@dimen/_6sdp"
                android:orientation="vertical">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:fontFamily="@font/plusjakartasans_bold"
                    android:text="@string/fuel_stop_planner"
                    android:textColor="@color/white"
                    android:singleLine="true"
                    android:ellipsize="end"
                    android:textSize="@dimen/_15sdp" />

                <TextView
                    android:id="@+id/tvHeaderRoute"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/fuel_planner_tagline"
                    android:textColor="#D2E4FF"
                    android:singleLine="true"
                    android:ellipsize="end"
                    android:textSize="@dimen/_9sdp" />
            </LinearLayout>

            <ImageView
                android:id="@+id/btnInfoDialog"
                android:layout_width="@dimen/_36sdp"
                android:layout_height="@dimen/_36sdp"
                android:layout_alignParentEnd="true"
                android:layout_centerVertical="true"
                android:layout_marginEnd="@dimen/_8sdp"
                android:background="?attr/selectableItemBackgroundBorderless"
                android:clickable="true"
                android:focusable="true"
                android:padding="@dimen/_8sdp"
                android:src="@drawable/baseline_info_24"
                app:tint="@color/white" />

        </RelativeLayout>

    </androidx.appcompat.widget.Toolbar>

    <!-- Scrollable content -->
    <androidx.core.widget.NestedScrollView
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:fillViewport="true">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:paddingHorizontal="@dimen/_10sdp"
            android:paddingTop="@dimen/_10sdp"
            android:paddingBottom="@dimen/_24sdp">

            <!-- Card: Trip & Vehicle Inputs -->
            <com.google.android.material.card.MaterialCardView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                app:cardBackgroundColor="@color/bgcolor_"
                app:cardCornerRadius="@dimen/_12sdp"
                app:cardElevation="@dimen/_1sdp"
                app:strokeColor="#8EC5FF"
                app:strokeWidth="1dp">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:padding="@dimen/_12sdp">

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:fontFamily="@font/plusjakartasans_bold"
                        android:text="@string/trip_info_title"
                        android:textColor="@color/color_primary"
                        android:textSize="@dimen/_13sdp" />

                    <!-- Route: Start & Destination -->
                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="@dimen/_8sdp"
                        android:orientation="horizontal">

                        <com.google.android.material.textfield.TextInputLayout
                            style="@style/Widget.MaterialComponents.TextInputLayout.OutlinedBox"
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_marginEnd="@dimen/_4sdp"
                            android:layout_weight="1"
                            android:hint="@string/starting_point">

                            <com.google.android.material.textfield.TextInputEditText
                                android:id="@+id/etStartLocation"
                                android:layout_width="match_parent"
                                android:layout_height="wrap_content"
                                android:imeOptions="actionNext"
                                android:inputType="textCapWords"
                                android:singleLine="true"
                                android:textSize="@dimen/_11sdp" />
                        </com.google.android.material.textfield.TextInputLayout>

                        <com.google.android.material.textfield.TextInputLayout
                            style="@style/Widget.MaterialComponents.TextInputLayout.OutlinedBox"
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_marginStart="@dimen/_4sdp"
                            android:layout_weight="1"
                            android:hint="@string/destination">

                            <com.google.android.material.textfield.TextInputEditText
                                android:id="@+id/etDestinationLocation"
                                android:layout_width="match_parent"
                                android:layout_height="wrap_content"
                                android:imeOptions="actionNext"
                                android:inputType="textCapWords"
                                android:singleLine="true"
                                android:textSize="@dimen/_11sdp" />
                        </com.google.android.material.textfield.TextInputLayout>
                    </LinearLayout>

                    <!-- Total Distance & Truck Number -->
                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="@dimen/_6sdp"
                        android:orientation="horizontal">

                        <com.google.android.material.textfield.TextInputLayout
                            style="@style/Widget.MaterialComponents.TextInputLayout.OutlinedBox"
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_marginEnd="@dimen/_4sdp"
                            android:layout_weight="1"
                            android:hint="@string/trip_distance_km">

                            <com.google.android.material.textfield.TextInputEditText
                                android:id="@+id/etDistance"
                                android:layout_width="match_parent"
                                android:layout_height="wrap_content"
                                android:imeOptions="actionNext"
                                android:inputType="numberDecimal"
                                android:singleLine="true"
                                android:textSize="@dimen/_11sdp" />
                        </com.google.android.material.textfield.TextInputLayout>

                        <com.google.android.material.textfield.TextInputLayout
                            style="@style/Widget.MaterialComponents.TextInputLayout.OutlinedBox"
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_marginStart="@dimen/_4sdp"
                            android:layout_weight="1"
                            android:hint="@string/truck_no_optional">

                            <com.google.android.material.textfield.TextInputEditText
                                android:id="@+id/etTruckNumber"
                                android:layout_width="match_parent"
                                android:layout_height="wrap_content"
                                android:imeOptions="actionNext"
                                android:inputType="textCapCharacters"
                                android:singleLine="true"
                                android:textSize="@dimen/_11sdp" />
                        </com.google.android.material.textfield.TextInputLayout>
                    </LinearLayout>

                    <!-- Load Condition -->
                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="@dimen/_10sdp"
                        android:fontFamily="@font/roboto_medium"
                        android:text="@string/load_condition_title"
                        android:textColor="@color/new_black"
                        android:textSize="@dimen/_11sdp" />

                    <com.google.android.material.chip.ChipGroup
                        android:id="@+id/chipGroupLoad"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="@dimen/_4sdp"
                        app:singleSelection="true">

                        <com.google.android.material.chip.Chip
                            android:id="@+id/chipEmpty"
                            style="@style/Widget.MaterialComponents.Chip.Choice"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="@string/empty_load" />

                        <com.google.android.material.chip.Chip
                            android:id="@+id/chipHalfLoaded"
                            style="@style/Widget.MaterialComponents.Chip.Choice"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="@string/half_loaded" />

                        <com.google.android.material.chip.Chip
                            android:id="@+id/chipFullyLoaded"
                            style="@style/Widget.MaterialComponents.Chip.Choice"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:checked="true"
                            android:text="@string/fully_loaded" />
                    </com.google.android.material.chip.ChipGroup>

                    <View
                        android:layout_width="match_parent"
                        android:layout_height="1dp"
                        android:layout_marginVertical="@dimen/_10sdp"
                        android:background="#D2E4FF" />

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:fontFamily="@font/plusjakartasans_bold"
                        android:text="@string/fuel_parameters_title"
                        android:textColor="@color/color_primary"
                        android:textSize="@dimen/_13sdp" />

                    <!-- Current Fuel & Tank Capacity -->
                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="@dimen/_8sdp"
                        android:orientation="horizontal">

                        <com.google.android.material.textfield.TextInputLayout
                            style="@style/Widget.MaterialComponents.TextInputLayout.OutlinedBox"
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_marginEnd="@dimen/_4sdp"
                            android:layout_weight="1"
                            android:hint="@string/current_fuel_liters">

                            <com.google.android.material.textfield.TextInputEditText
                                android:id="@+id/etCurrentFuel"
                                android:layout_width="match_parent"
                                android:layout_height="wrap_content"
                                android:imeOptions="actionNext"
                                android:inputType="numberDecimal"
                                android:singleLine="true"
                                android:textSize="@dimen/_11sdp" />
                        </com.google.android.material.textfield.TextInputLayout>

                        <com.google.android.material.textfield.TextInputLayout
                            style="@style/Widget.MaterialComponents.TextInputLayout.OutlinedBox"
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_marginStart="@dimen/_4sdp"
                            android:layout_weight="1"
                            android:hint="@string/tank_capacity_liters">

                            <com.google.android.material.textfield.TextInputEditText
                                android:id="@+id/etTankCapacity"
                                android:layout_width="match_parent"
                                android:layout_height="wrap_content"
                                android:imeOptions="actionNext"
                                android:inputType="numberDecimal"
                                android:singleLine="true"
                                android:textSize="@dimen/_11sdp" />
                        </com.google.android.material.textfield.TextInputLayout>
                    </LinearLayout>

                    <!-- Mileage & Fuel Price -->
                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="@dimen/_6sdp"
                        android:orientation="horizontal">

                        <com.google.android.material.textfield.TextInputLayout
                            style="@style/Widget.MaterialComponents.TextInputLayout.OutlinedBox"
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_marginEnd="@dimen/_4sdp"
                            android:layout_weight="1"
                            android:hint="@string/average_mileage_km_l">

                            <com.google.android.material.textfield.TextInputEditText
                                android:id="@+id/etMileage"
                                android:layout_width="match_parent"
                                android:layout_height="wrap_content"
                                android:imeOptions="actionNext"
                                android:inputType="numberDecimal"
                                android:singleLine="true"
                                android:textSize="@dimen/_11sdp" />
                        </com.google.android.material.textfield.TextInputLayout>

                        <com.google.android.material.textfield.TextInputLayout
                            style="@style/Widget.MaterialComponents.TextInputLayout.OutlinedBox"
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_marginStart="@dimen/_4sdp"
                            android:layout_weight="1"
                            android:hint="@string/fuel_price_per_liter">

                            <com.google.android.material.textfield.TextInputEditText
                                android:id="@+id/etFuelPrice"
                                android:layout_width="match_parent"
                                android:layout_height="wrap_content"
                                android:imeOptions="actionDone"
                                android:inputType="numberDecimal"
                                android:singleLine="true"
                                android:textSize="@dimen/_11sdp" />
                        </com.google.android.material.textfield.TextInputLayout>
                    </LinearLayout>

                    <!-- Safety Reserve Selector -->
                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="@dimen/_10sdp"
                        android:gravity="center_vertical"
                        android:orientation="horizontal">

                        <TextView
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_weight="1"
                            android:fontFamily="@font/roboto_medium"
                            android:text="@string/safety_reserve_title"
                            android:textColor="@color/new_black"
                            android:textSize="@dimen/_11sdp" />

                        <TextView
                            android:id="@+id/btnExplainReserve"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="@string/why_reserve_title"
                            android:textColor="@color/color_primary"
                            android:textSize="@dimen/_10sdp"
                            android:textStyle="bold" />
                    </LinearLayout>

                    <com.google.android.material.chip.ChipGroup
                        android:id="@+id/chipGroupReserve"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="@dimen/_4sdp"
                        app:singleSelection="true">

                        <com.google.android.material.chip.Chip
                            android:id="@+id/chipReserve10"
                            style="@style/Widget.MaterialComponents.Chip.Choice"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="10%" />

                        <com.google.android.material.chip.Chip
                            android:id="@+id/chipReserve15"
                            style="@style/Widget.MaterialComponents.Chip.Choice"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="15%" />

                        <com.google.android.material.chip.Chip
                            android:id="@+id/chipReserve20"
                            style="@style/Widget.MaterialComponents.Chip.Choice"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:checked="true"
                            android:text="@string/twenty_percent_recommended" />
                    </com.google.android.material.chip.ChipGroup>

                    <TextView
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="@dimen/_4sdp"
                        android:text="@string/safety_reserve_explanation"
                        android:textColor="@color/details_text_color"
                        android:textSize="@dimen/_9sdp" />

                    <!-- Action Buttons -->
                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="@dimen/_12sdp"
                        android:orientation="horizontal">

                        <com.google.android.material.button.MaterialButton
                            android:id="@+id/btnFillTank"
                            style="@style/Widget.MaterialComponents.Button.OutlinedButton"
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_marginEnd="@dimen/_4sdp"
                            android:layout_weight="1"
                            android:fontFamily="@font/plusjakartasans_bold"
                            android:text="@string/btn_fill_tank"
                            android:textColor="@color/color_primary"
                            app:strokeColor="@color/color_primary" />

                        <com.google.android.material.button.MaterialButton
                            android:id="@+id/btnCalculate"
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_marginStart="@dimen/_4sdp"
                            android:layout_weight="1.6"
                            android:backgroundTint="@color/color_primary"
                            android:fontFamily="@font/plusjakartasans_bold"
                            android:text="@string/btn_calculate_plan"
                            android:textColor="@color/white" />
                    </LinearLayout>

                </LinearLayout>

            </com.google.android.material.card.MaterialCardView>

            <!-- Results Container (Visible after calculation) -->
            <LinearLayout
                android:id="@+id/resultContainer"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/_12sdp"
                android:orientation="vertical"
                android:visibility="gone"
                tools:visibility="visible">

                <!-- 1. Prominent Reachability Status Card -->
                <com.google.android.material.card.MaterialCardView
                    android:id="@+id/cardReachabilityStatus"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    app:cardCornerRadius="@dimen/_10sdp"
                    app:cardElevation="@dimen/_2sdp"
                    app:strokeWidth="1.5dp">

                    <LinearLayout
                        android:id="@+id/layoutStatusHeader"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="vertical"
                        android:padding="@dimen/_12sdp">

                        <TextView
                            android:id="@+id/tvStatusBadge"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:fontFamily="@font/plusjakartasans_bold"
                            android:textSize="@dimen/_14sdp"
                            tools:text="🟠 REFUEL RECOMMENDED" />

                        <TextView
                            android:id="@+id/tvStatusDescription"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="@dimen/_4sdp"
                            android:fontFamily="@font/roboto_medium"
                            android:textSize="@dimen/_11sdp"
                            tools:text="Your current fuel can cover the trip, but refuelling is recommended to maintain your safety reserve." />
                    </LinearLayout>

                </com.google.android.material.card.MaterialCardView>

                <!-- 2. Refuelling Recommendation Card -->
                <com.google.android.material.card.MaterialCardView
                    android:id="@+id/cardRecommendation"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="@dimen/_10sdp"
                    app:cardBackgroundColor="#F1F6FF"
                    app:cardCornerRadius="@dimen/_10sdp"
                    app:cardElevation="@dimen/_1sdp"
                    app:strokeColor="#8EC5FF"
                    app:strokeWidth="1dp">

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="vertical"
                        android:padding="@dimen/_12sdp">

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:fontFamily="@font/plusjakartasans_bold"
                            android:text="@string/fuel_recommendation_title"
                            android:textColor="@color/color_primary"
                            android:textSize="@dimen/_12sdp" />

                        <TextView
                            android:id="@+id/tvRecommendedRefuelDistance"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="@dimen/_4sdp"
                            android:fontFamily="@font/plusjakartasans_bold"
                            android:textColor="@color/new_black"
                            android:textSize="@dimen/_13sdp"
                            tools:text="Refuel around 400 – 430 km" />

                        <TextView
                            android:id="@+id/tvRecommendedFuelQuantity"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="@dimen/_2sdp"
                            android:textColor="@color/details_text_color"
                            android:textSize="@dimen/_11sdp"
                            tools:text="Recommended Fuel to add: ~80.0 L" />
                    </LinearLayout>

                </com.google.android.material.card.MaterialCardView>

                <!-- 3. Key Fuel & Range Metrics Card -->
                <com.google.android.material.card.MaterialCardView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="@dimen/_10sdp"
                    app:cardBackgroundColor="@color/white"
                    app:cardCornerRadius="@dimen/_10sdp"
                    app:cardElevation="@dimen/_1sdp"
                    app:strokeColor="#E0E0E0"
                    app:strokeWidth="1dp">

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="vertical"
                        android:padding="@dimen/_12sdp">

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:fontFamily="@font/plusjakartasans_bold"
                            android:text="@string/range_fuel_analysis_title"
                            android:textColor="@color/new_black"
                            android:textSize="@dimen/_12sdp" />

                        <!-- Metric Row 1: Safe Range & Theoretical Range -->
                        <LinearLayout
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="@dimen/_8sdp"
                            android:orientation="horizontal">

                            <LinearLayout
                                android:layout_width="0dp"
                                android:layout_height="wrap_content"
                                android:layout_weight="1"
                                android:orientation="vertical">

                                <TextView
                                    android:layout_width="wrap_content"
                                    android:layout_height="wrap_content"
                                    android:text="@string/safe_driving_range"
                                    android:textColor="@color/details_text_color"
                                    android:textSize="@dimen/_10sdp" />

                                <TextView
                                    android:id="@+id/tvSafeRange"
                                    android:layout_width="wrap_content"
                                    android:layout_height="wrap_content"
                                    android:fontFamily="@font/plusjakartasans_bold"
                                    android:textColor="@color/color_primary"
                                    android:textSize="@dimen/_14sdp"
                                    tools:text="456.0 km" />
                            </LinearLayout>

                            <LinearLayout
                                android:layout_width="0dp"
                                android:layout_height="wrap_content"
                                android:layout_weight="1"
                                android:orientation="vertical">

                                <TextView
                                    android:layout_width="wrap_content"
                                    android:layout_height="wrap_content"
                                    android:text="@string/current_driving_range"
                                    android:textColor="@color/details_text_color"
                                    android:textSize="@dimen/_10sdp" />

                                <TextView
                                    android:id="@+id/tvTheoreticalRange"
                                    android:layout_width="wrap_content"
                                    android:layout_height="wrap_content"
                                    android:fontFamily="@font/plusjakartasans_bold"
                                    android:textColor="@color/new_black"
                                    android:textSize="@dimen/_14sdp"
                                    tools:text="570.0 km" />
                            </LinearLayout>
                        </LinearLayout>

                        <View
                            android:layout_width="match_parent"
                            android:layout_height="1dp"
                            android:layout_marginVertical="@dimen/_8sdp"
                            android:background="#EFEFEF" />

                        <!-- Metric Row 2: Estimated Fuel & With Safety -->
                        <LinearLayout
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:orientation="horizontal">

                            <LinearLayout
                                android:layout_width="0dp"
                                android:layout_height="wrap_content"
                                android:layout_weight="1"
                                android:orientation="vertical">

                                <TextView
                                    android:layout_width="wrap_content"
                                    android:layout_height="wrap_content"
                                    android:text="@string/estimated_fuel_required"
                                    android:textColor="@color/details_text_color"
                                    android:textSize="@dimen/_10sdp" />

                                <TextView
                                    android:id="@+id/tvEstimatedFuel"
                                    android:layout_width="wrap_content"
                                    android:layout_height="wrap_content"
                                    android:fontFamily="@font/plusjakartasans_bold"
                                    android:textColor="@color/new_black"
                                    android:textSize="@dimen/_13sdp"
                                    tools:text="138.2 L" />
                            </LinearLayout>

                            <LinearLayout
                                android:layout_width="0dp"
                                android:layout_height="wrap_content"
                                android:layout_weight="1"
                                android:orientation="vertical">

                                <TextView
                                    android:layout_width="wrap_content"
                                    android:layout_height="wrap_content"
                                    android:text="@string/fuel_with_safety"
                                    android:textColor="@color/details_text_color"
                                    android:textSize="@dimen/_10sdp" />

                                <TextView
                                    android:id="@+id/tvFuelWithSafety"
                                    android:layout_width="wrap_content"
                                    android:layout_height="wrap_content"
                                    android:fontFamily="@font/plusjakartasans_bold"
                                    android:textColor="@color/new_black"
                                    android:textSize="@dimen/_13sdp"
                                    tools:text="165.8 L" />
                            </LinearLayout>
                        </LinearLayout>

                        <View
                            android:layout_width="match_parent"
                            android:layout_height="1dp"
                            android:layout_marginVertical="@dimen/_8sdp"
                            android:background="#EFEFEF" />

                        <!-- Metric Row 3: Fuel Remaining At Destination -->
                        <LinearLayout
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:orientation="horizontal">

                            <LinearLayout
                                android:layout_width="0dp"
                                android:layout_height="wrap_content"
                                android:layout_weight="1"
                                android:orientation="vertical">

                                <TextView
                                    android:layout_width="wrap_content"
                                    android:layout_height="wrap_content"
                                    android:text="@string/fuel_remaining_at_dest"
                                    android:textColor="@color/details_text_color"
                                    android:textSize="@dimen/_10sdp" />

                                <TextView
                                    android:id="@+id/tvFuelRemainingAtDest"
                                    android:layout_width="wrap_content"
                                    android:layout_height="wrap_content"
                                    android:fontFamily="@font/plusjakartasans_bold"
                                    android:textSize="@dimen/_13sdp"
                                    tools:text="11.8 L" />
                            </LinearLayout>
                        </LinearLayout>

                    </LinearLayout>

                </com.google.android.material.card.MaterialCardView>

                <!-- 4. Estimated Cost & Profit Integration Card -->
                <com.google.android.material.card.MaterialCardView
                    android:id="@+id/cardCost"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="@dimen/_10sdp"
                    app:cardBackgroundColor="@color/bgcolor_"
                    app:cardCornerRadius="@dimen/_10sdp"
                    app:cardElevation="@dimen/_1sdp"
                    app:strokeColor="#8EC5FF"
                    app:strokeWidth="1dp">

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="vertical"
                        android:padding="@dimen/_12sdp">

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:fontFamily="@font/plusjakartasans_bold"
                            android:text="@string/estimated_fuel_cost_title"
                            android:textColor="@color/color_primary"
                            android:textSize="@dimen/_12sdp" />

                        <LinearLayout
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="@dimen/_6sdp"
                            android:orientation="horizontal">

                            <LinearLayout
                                android:layout_width="0dp"
                                android:layout_height="wrap_content"
                                android:layout_weight="1"
                                android:orientation="vertical">

                                <TextView
                                    android:layout_width="wrap_content"
                                    android:layout_height="wrap_content"
                                    android:text="@string/total_cost_label"
                                    android:textColor="@color/details_text_color"
                                    android:textSize="@dimen/_10sdp" />

                                <TextView
                                    android:id="@+id/tvTotalFuelCost"
                                    android:layout_width="wrap_content"
                                    android:layout_height="wrap_content"
                                    android:fontFamily="@font/plusjakartasans_bold"
                                    android:textColor="#0E8A37"
                                    android:textSize="@dimen/_15sdp"
                                    tools:text="₹ 13,125.00" />
                            </LinearLayout>

                            <LinearLayout
                                android:layout_width="0dp"
                                android:layout_height="wrap_content"
                                android:layout_weight="1"
                                android:orientation="vertical">

                                <TextView
                                    android:layout_width="wrap_content"
                                    android:layout_height="wrap_content"
                                    android:text="@string/cost_per_km_label"
                                    android:textColor="@color/details_text_color"
                                    android:textSize="@dimen/_10sdp" />

                                <TextView
                                    android:id="@+id/tvCostPerKm"
                                    android:layout_width="wrap_content"
                                    android:layout_height="wrap_content"
                                    android:fontFamily="@font/plusjakartasans_bold"
                                    android:textColor="@color/new_black"
                                    android:textSize="@dimen/_13sdp"
                                    tools:text="₹ 25.00 / km" />
                            </LinearLayout>
                        </LinearLayout>

                        <!-- Integration Button: Send to Trip Profit / Estimator -->
                        <com.google.android.material.button.MaterialButton
                            android:id="@+id/btnSendToEstimator"
                            style="@style/Widget.MaterialComponents.Button.TextButton"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="@dimen/_6sdp"
                            android:fontFamily="@font/plusjakartasans_bold"
                            android:text="@string/send_fuel_cost_to_estimator"
                            android:textColor="@color/color_primary"
                            android:textSize="@dimen/_11sdp" />

                    </LinearLayout>

                </com.google.android.material.card.MaterialCardView>

                <!-- 5. Multi-Stop Fuel Timeline View -->
                <LinearLayout
                    android:id="@+id/layoutStopsSection"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="@dimen/_14sdp"
                    android:orientation="vertical">

                    <TextView
                        android:id="@+id/tvStopsHeader"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:fontFamily="@font/plusjakartasans_bold"
                        android:text="@string/fuel_stop_timeline"
                        android:textColor="@color/new_black"
                        android:textSize="@dimen/_13sdp" />

                    <TextView
                        android:id="@+id/tvNoStopsMessage"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="@dimen/_6sdp"
                        android:text="@string/no_stops_needed"
                        android:textColor="#0E8A37"
                        android:textSize="@dimen/_11sdp"
                        android:visibility="gone" />

                    <androidx.recyclerview.widget.RecyclerView
                        android:id="@+id/rvFuelStops"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="@dimen/_6sdp"
                        android:nestedScrollingEnabled="false" />

                </LinearLayout>

                <!-- Future Station Integration Notice -->
                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="@dimen/_16sdp"
                    android:background="@drawable/bg_rounded_edittext"
                    android:backgroundTint="#F8F9FA"
                    android:padding="@dimen/_8sdp"
                    android:text="@string/fuel_station_connect_msg"
                    android:textColor="@color/details_text_color"
                    android:textSize="@dimen/_9sdp" />

            </LinearLayout>

        </LinearLayout>

    </androidx.core.widget.NestedScrollView>

</LinearLayout>
