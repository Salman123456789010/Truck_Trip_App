<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:card_view="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent">

    <!-- Actual card content -->
    <androidx.cardview.widget.CardView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_gravity="center"
        android:layout_marginTop="@dimen/_16sdp"
        android:layout_marginBottom="@dimen/_16sdp"
        android:layout_marginStart="@dimen/_2sdp"
        android:layout_marginEnd="@dimen/_2sdp"
        card_view:cardCornerRadius="@dimen/_18sdp"
        card_view:cardElevation="@dimen/_6sdp"
        card_view:cardUseCompatPadding="true">

        <!-- ✅ ScrollView added here -->
        <ScrollView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:fillViewport="true"
            android:overScrollMode="never">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:gravity="center_horizontal"
                android:padding="@dimen/_16sdp">

                <ImageView
                    android:id="@+id/imageHowTo"
                    android:layout_width="match_parent"
                    android:layout_height="@dimen/_260sdp"
                    android:adjustViewBounds="true"
                    android:scaleType="fitCenter"
                    android:contentDescription="@null" />

                <TextView
                    android:id="@+id/textTitle"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="@dimen/_12sdp"
                    android:gravity="center"
                    android:fontFamily="@font/roboto_medium"
                    android:text="Title"
                    android:textSize="@dimen/_13sdp"
                    android:textColor="@color/black" />

                <TextView
                    android:id="@+id/textDescription"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="@dimen/_6sdp"
                    android:gravity="center"
                    android:lineSpacingExtra="@dimen/_2sdp"
                    android:text="Description about this step goes here."
                    android:textSize="@dimen/_11sdp"
                    android:textColor="@color/grey" />

                <!-- place inside the LinearLayout (below textDescription) -->
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal"
                    android:gravity="center"
                    android:layout_marginTop="@dimen/_8sdp">

                    <ImageView
                        android:id="@+id/btnSpeak"
                        android:layout_width="@dimen/_30sdp"
                        android:layout_height="@dimen/_30sdp"
                        android:src="@drawable/voice_assistants"
                        android:tint="@color/color_primary"
                        android:contentDescription="@string/dest_place_"
                     />

                    <ImageView
                        android:id="@+id/btnStopSpeak"
                        android:layout_width="@dimen/_30sdp"
                        android:layout_height="@dimen/_30sdp"
                        android:src="@drawable/stop"
                        android:contentDescription="@string/place_city"
                        android:tint="@color/color_primary"
                        android:layout_marginStart="@dimen/_20sdp"/>
                </LinearLayout>

            </LinearLayout>

        </ScrollView>

    </androidx.cardview.widget.CardView>

</FrameLayout>
