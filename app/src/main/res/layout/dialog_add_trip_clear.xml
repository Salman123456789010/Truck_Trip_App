<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:padding="16dp">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical">

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="📋 ट्रिप की जानकारी"
            android:textSize="16sp"
            android:textStyle="bold"
            android:layout_marginBottom="12dp"/>

        <EditText
            android:id="@+id/etDate"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:hint="📅 तारीख (dd/mm/yyyy)"
            android:inputType="date"
            android:padding="12dp"
            android:layout_marginBottom="12dp"/>

        <EditText
            android:id="@+id/etFrom"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:hint="📍 कहाँ से"
            android:inputType="text"
            android:padding="12dp"
            android:layout_marginBottom="12dp"/>

        <EditText
            android:id="@+id/etTo"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:hint="📍 कहाँ तक"
            android:inputType="text"
            android:padding="12dp"
            android:layout_marginBottom="12dp"/>

        <EditText
            android:id="@+id/etVehicle"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:hint="🚛 गाड़ी नंबर"
            android:inputType="textCapCharacters"
            android:padding="12dp"
            android:layout_marginBottom="16dp"/>

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="💰 पैसे की जानकारी"
            android:textSize="16sp"
            android:textStyle="bold"
            android:layout_marginBottom="12dp"/>

        <EditText
            android:id="@+id/etFreight"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:hint="💵 कुल भाड़ा (₹)"
            android:inputType="number"
            android:padding="12dp"
            android:layout_marginBottom="12dp"/>

        <EditText
            android:id="@+id/etAdvance"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:hint="💰 एडवांस मिला (₹)"
            android:inputType="number"
            android:padding="12dp"
            android:layout_marginBottom="12dp"/>

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="ℹ️ एडवांस = पहले से जो पैसा मिल गया"
            android:textSize="12sp"
            android:textColor="#666666"
            android:layout_marginBottom="12dp"/>

        <EditText
            android:id="@+id/etNotes"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:hint="📝 नोट (optional)"
            android:inputType="textMultiLine"
            android:lines="3"
            android:padding="12dp"/>

    </LinearLayout>
</ScrollView>
