<?xml version="1.0" encoding="utf-8"?>
<androidx.cardview.widget.CardView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:background="@color/white"
    android:elevation="@dimen/_5sdp"
    android:fitsSystemWindows="true"
    app:cardCornerRadius="@dimen/_10sdp"
    android:orientation="vertical">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="@dimen/_16sdp"
        android:background="@color/white">

        <!-- Title -->
        <TextView
            android:id="@+id/title"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="@string/complete_trip"
            android:textSize="@dimen/_18sdp"
            android:textStyle="bold"
            android:textColor="@color/black"
            android:paddingBottom="@dimen/_10sdp"
            android:fontFamily="@font/roboto_medium"
            android:gravity="center" />

        <!-- End Trip Date Section -->
        <TextView
            android:id="@+id/dateLabel"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:fontFamily="@font/roboto_medium"
            android:layout_marginStart="@dimen/_5sdp"
            android:layout_marginEnd="@dimen/_5sdp"
            android:text="@string/end_trip_date_"
            android:textColor="@color/black"
            android:textSize="@dimen/_13sdp" />

        <com.google.android.material.card.MaterialCardView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginStart="@dimen/_5sdp"
            android:layout_marginTop="@dimen/_8sdp"
            android:layout_marginEnd="@dimen/_5sdp"
            app:cardBackgroundColor="@color/white"
            app:cardCornerRadius="@dimen/_8sdp"
            app:strokeColor="@color/green"
            app:strokeWidth="@dimen/_1sdp">

            <LinearLayout
                android:id="@+id/datePicker"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:gravity="center_vertical"
                android:orientation="horizontal"
                android:paddingStart="@dimen/_12sdp"
                android:paddingTop="@dimen/_10sdp"
                android:paddingEnd="@dimen/_12sdp"
                android:paddingBottom="@dimen/_10sdp">

                <TextView
                    android:id="@+id/etEndDate"
                    android:layout_width="0dp"
                    android:layout_weight="1"
                    android:layout_height="wrap_content"
                    android:fontFamily="sans-serif-condensed-medium"
                    android:hint="@string/end_trip_date"
                    android:textColor="@color/black"
                    android:textColorHint="@color/date_hint_color"
                    android:textSize="@dimen/_13sdp" />

                <ImageView
                    android:id="@+id/speaker"
                    android:layout_width="@dimen/_24sdp"
                    android:layout_height="@dimen/_24sdp"
                    android:src="@drawable/baseline_speaker_24"
                    app:tint="@color/color_primary" />

            </LinearLayout>

        </com.google.android.material.card.MaterialCardView>

        <!-- Driver Income Section -->
        <TextView
            android:id="@+id/driverincomeLabel"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:fontFamily="@font/roboto_medium"
            android:layout_marginStart="@dimen/_5sdp"
            android:layout_marginEnd="@dimen/_5sdp"
            android:text="@string/driver_income_for_trip_"
            android:layout_marginTop="@dimen/_12sdp"
            android:textColor="@color/black"
            android:textSize="@dimen/_13sdp" />

        <com.google.android.material.card.MaterialCardView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginStart="@dimen/_5sdp"
            android:layout_marginTop="@dimen/_8sdp"
            android:layout_marginEnd="@dimen/_5sdp"
            app:cardBackgroundColor="@color/white"
            app:cardCornerRadius="@dimen/_8sdp"
            app:strokeColor="@color/green"
            app:strokeWidth="@dimen/_1sdp">

            <LinearLayout
                android:id="@+id/driverIncome"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:gravity="center_vertical"
                android:orientation="horizontal"
                android:paddingStart="@dimen/_12sdp"
                android:paddingTop="@dimen/_10sdp"
                android:paddingEnd="@dimen/_12sdp"
                android:paddingBottom="@dimen/_10sdp">

                <com.google.android.material.textfield.TextInputEditText
                    android:id="@+id/etDriverIncome"
                    android:layout_width="0dp"
                    android:layout_weight="1"
                    android:layout_height="wrap_content"
                    android:fontFamily="sans-serif-condensed-medium"
                    android:hint="@string/driver_income"
                    android:textColor="@color/black"
                    android:textColorHint="@color/date_hint_color"
                    android:textSize="@dimen/_13sdp"
                    android:background="@null"
                    android:inputType="numberDecimal"
                    android:imeOptions="actionDone" />

                <ImageView
                    android:id="@+id/driverIncomeSpeaker"
                    android:layout_width="@dimen/_24sdp"
                    android:layout_height="@dimen/_24sdp"
                    android:src="@drawable/baseline_speaker_24"
                    app:tint="@color/color_primary" />

            </LinearLayout>

        </com.google.android.material.card.MaterialCardView>

        <!-- End KM Input Type Section -->
        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/_12sdp"
            android:layout_marginStart="@dimen/_5sdp"
            android:layout_marginEnd="@dimen/_5sdp"
            android:text="@string/end_km_input_type"
            android:visibility="gone"
            android:textSize="@dimen/_13sdp"
            android:textColor="@color/black"
            android:fontFamily="@font/roboto_medium" />

        <RadioGroup
            android:id="@+id/rgEndKmInputType"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:layout_marginTop="@dimen/_8sdp"
            android:layout_marginStart="@dimen/_5sdp"
            android:layout_marginEnd="@dimen/_5sdp">

            <RadioButton
                android:id="@+id/rbEndOdometer"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:text="@string/end_odometer"
                android:textSize="@dimen/_12sdp"
                android:checked="true"
                android:singleLine="true"
                android:paddingEnd="@dimen/_5sdp"
                android:buttonTint="@color/color_primary" />

            <RadioButton
                android:id="@+id/rbEndKm"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:text="@string/manual_km"
                android:textSize="@dimen/_12sdp"
                android:singleLine="true"
                android:paddingStart="@dimen/_5sdp"
                android:buttonTint="@color/color_primary" />

        </RadioGroup>

        <!-- End KM / Odometer Input -->
        <com.google.android.material.card.MaterialCardView
            android:id="@+id/tilEndKm"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginStart="@dimen/_5sdp"
            android:layout_marginTop="@dimen/_8sdp"
            android:layout_marginEnd="@dimen/_5sdp"
            app:cardBackgroundColor="@color/white"
            app:cardCornerRadius="@dimen/_8sdp"
            app:strokeColor="@color/green"
            app:strokeWidth="@dimen/_1sdp">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:gravity="center_vertical"
                android:paddingStart="@dimen/_12sdp"
                android:paddingTop="@dimen/_10sdp"
                android:paddingEnd="@dimen/_12sdp"
                android:paddingBottom="@dimen/_10sdp">

                <com.google.android.material.textfield.TextInputEditText
                    android:id="@+id/etEndKm"
                    android:layout_width="0dp"
                    android:layout_weight="1"
                    android:layout_height="wrap_content"
                    android:background="@null"
                    android:hint="@string/end_odometer_reading"
                    android:textColor="@color/black"
                    android:textColorHint="@color/date_hint_color"
                    android:fontFamily="sans-serif-condensed-medium"
                    android:inputType="number"
                    android:maxLength="9"
                    android:textSize="@dimen/_13sdp" />

                <ImageView
                    android:id="@+id/kmSpeaker"
                    android:layout_width="@dimen/_24sdp"
                    android:layout_height="@dimen/_24sdp"
                    android:src="@drawable/baseline_speaker_24"
                    app:tint="@color/color_primary" />
            </LinearLayout>

        </com.google.android.material.card.MaterialCardView>

        <!-- Buttons -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:layout_marginTop="@dimen/_20sdp"
            android:gravity="end">

            <androidx.cardview.widget.CardView
                android:layout_width="0dp"
                android:layout_weight="1"
                android:layout_height="wrap_content"
                android:layout_marginEnd="@dimen/_8sdp"
                app:cardBackgroundColor="@color/grey"
                app:cardCornerRadius="@dimen/_10sdp">

                <TextView
                    android:id="@+id/btnCancel"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:fontFamily="@font/roboto_medium"
                    android:padding="@dimen/_12sdp"
                    android:textColor="@color/white"
                    android:maxLines="1"
                    android:text="@string/cancel"
                    android:gravity="center"
                    android:textSize="@dimen/_14sdp" />
            </androidx.cardview.widget.CardView>

            <androidx.cardview.widget.CardView
                android:layout_width="0dp"
                android:layout_weight="1"
                android:layout_height="wrap_content"
                android:layout_marginStart="@dimen/_8sdp"
                app:cardBackgroundColor="@color/color_primary"
                app:cardCornerRadius="@dimen/_10sdp">

                <TextView
                    android:id="@+id/btnSubmit"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:fontFamily="@font/roboto_medium"
                    android:padding="@dimen/_12sdp"
                    android:textColor="@color/white"
                    android:text="@string/submit"
                    android:maxLines="1"
                    android:gravity="center"
                    android:textSize="@dimen/_14sdp" />
            </androidx.cardview.widget.CardView>
        </LinearLayout>

    </LinearLayout>
</androidx.cardview.widget.CardView>