<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="vertical"
    android:background="@android:color/white">

    <!-- Top Section - Fixed -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="@dimen/_10sdp">

        <TextView
            android:id="@+id/tvTitle"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/kharcha_dalo"
            android:textSize="@dimen/_12sdp"
           android:fontFamily="@font/roboto_medium"
            android:textColor="#333333"
            android:layout_marginBottom="20dp" />

        <!-- Mic Button -->
        <com.google.android.material.floatingactionbutton.FloatingActionButton
            android:id="@+id/fabMic"
            android:layout_width="120dp"
            android:layout_height="120dp"
            android:layout_gravity="center"
            app:fabCustomSize="120dp"
            app:maxImageSize="60dp"
            android:src="@drawable/mic_phone"
            app:tint="#FFFFFF"
            app:backgroundTint="@color/tamil_txt"

            android:layout_marginBottom="16dp" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/bolo_khane_ke_500"
            android:textSize="16sp"
            android:textColor="#666666"
            android:layout_gravity="center"
            android:layout_marginBottom="24dp" />

        <!-- List Header -->
        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/aapki_list"
            android:textSize="16sp"
          android:fontFamily="@font/roboto_medium"
            android:layout_marginBottom="12dp" />
    </LinearLayout>

    <!-- Scrollable List Section -->
    <androidx.recyclerview.widget.RecyclerView
        android:id="@+id/rvBottomSheetExpenses"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:minHeight="100dp"
        android:maxHeight="300dp"
        android:paddingStart="20dp"
        android:paddingEnd="20dp"
        android:clipToPadding="false" />

    <!-- Bottom Button - Fixed -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="20dp"
        android:background="@android:color/white"
        android:elevation="4dp">

        <com.google.android.material.button.MaterialButton
            android:id="@+id/btnSave"
            android:layout_width="match_parent"
            android:layout_height="56dp"
            android:text="@string/save_karo"
            android:textSize="18sp"
            android:textStyle="bold"
            app:backgroundTint="@color/color_primary"
            app:cornerRadius="12dp"
            android:textColor="#FFFFFF" />
    </LinearLayout>
</LinearLayout>