<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="@dimen/_40sdp"
    android:paddingStart="@dimen/_8sdp"
    android:paddingEnd="@dimen/_8sdp"
    android:paddingTop="@dimen/_2sdp"
    android:paddingBottom="@dimen/_2sdp">

    <!-- Place Icon -->
    <ImageView
        android:id="@+id/ivPlaceIcon"
        android:layout_width="@dimen/_10sdp"
        android:layout_height="@dimen/_10sdp"
        android:src="@drawable/ic_middle_place"
        app:tint="@color/color_primary"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent" />

    <!-- Connector Line -->
    <View
        android:id="@+id/viewConnector"
        android:layout_width="@dimen/_1sdp"
        android:layout_height="0dp"
        android:background="@color/color_primary"
        app:layout_constraintStart_toStartOf="@id/ivPlaceIcon"
        app:layout_constraintEnd_toEndOf="@id/ivPlaceIcon"
        app:layout_constraintTop_toBottomOf="@id/ivPlaceIcon"
        app:layout_constraintBottom_toBottomOf="parent" />

    <!-- Delete Button (only for middle places) -->
    <ImageView
        android:id="@+id/btnDelete"
        android:layout_width="@dimen/_20sdp"
        android:layout_height="@dimen/_20sdp"
        android:src="@drawable/baseline_delete_24"
        android:padding="@dimen/_4sdp"
        android:background="@drawable/bg_red_circle"
        app:tint="@color/white"
        android:visibility="visible"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintBottom_toBottomOf="parent" />

    <!-- Content Card -->
    <com.google.android.material.card.MaterialCardView
        android:id="@+id/cardPlace"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginStart="@dimen/_8sdp"
        android:layout_marginEnd="@dimen/_8sdp"
        app:cardCornerRadius="@dimen/_8sdp"
        app:cardElevation="@dimen/_1sdp"
        app:strokeColor="@color/green"
        app:strokeWidth="@dimen/_1sdp"
        app:layout_constraintStart_toEndOf="@id/ivPlaceIcon"
        app:layout_constraintEnd_toStartOf="@id/btnDelete"
        app:layout_constraintTop_toTopOf="parent">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:padding="@dimen/_6sdp">

            <TextView
                android:id="@+id/tvPlaceLabel"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/via"
                android:textSize="@dimen/_6sdp"
                android:textColor="@color/_78060c29"
                android:fontFamily="@font/roboto_medium" />

            <TextView
                android:id="@+id/tvPlace"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="Place Name"
                android:textSize="@dimen/_8sdp"
                android:textColor="@color/black"
                android:fontFamily="@font/roboto_bold"
                android:maxLines="2"
                android:ellipsize="end"
                android:layout_marginTop="@dimen/_1sdp" />
        </LinearLayout>
    </com.google.android.material.card.MaterialCardView>

</androidx.constraintlayout.widget.ConstraintLayout>