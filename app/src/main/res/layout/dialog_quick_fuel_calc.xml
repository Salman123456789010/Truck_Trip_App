<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="vertical"
    android:padding="@dimen/_14sdp">

    <TextView
        android:id="@+id/tvDialogTotalDistance"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:fontFamily="@font/roboto_medium"
        android:text="Trip Distance: 1,000 km (Outbound + Return)"
        android:textColor="@color/color_primary"
        android:textSize="@dimen/_11sdp" />

    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="@dimen/_10sdp"
        android:fontFamily="@font/roboto_regular"
        android:text="@string/truck_average_mileage_km_l"
        android:textColor="@color/black"
        android:textSize="@dimen/_10sdp" />

    <EditText
        android:id="@+id/etDialogMileage"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="@dimen/_4sdp"
        android:background="@drawable/bg_rounded_edittext"
        android:fontFamily="@font/roboto_bold"
        android:hint="e.g. 3.8"
        android:inputType="numberDecimal"
        android:padding="@dimen/_8sdp"
        android:textColor="@color/black"
        android:textSize="@dimen/_12sdp" />

    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="@dimen/_10sdp"
        android:fontFamily="@font/roboto_regular"
        android:text="Diesel Price per Liter (₹):"
        android:textColor="@color/black"
        android:textSize="@dimen/_10sdp" />

    <EditText
        android:id="@+id/etDialogFuelPrice"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="@dimen/_4sdp"
        android:background="@drawable/bg_rounded_edittext"
        android:fontFamily="@font/roboto_bold"
        android:hint="e.g. 95"
        android:inputType="numberDecimal"
        android:padding="@dimen/_8sdp"
        android:textColor="@color/black"
        android:textSize="@dimen/_12sdp" />

</LinearLayout>
