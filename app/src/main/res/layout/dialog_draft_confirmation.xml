<?xml version="1.0" encoding="utf-8"?>
<!-- dialog_draft_confirmation.xml -->
<!-- Save as: res/layout/dialog_draft_confirmation.xml -->
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:fillViewport="true">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:background="@drawable/bg_draft_dialog"
        android:layout_margin="@dimen/_10sdp"
        android:padding="@dimen/_20sdp"
        android:minHeight="@dimen/_200sdp">

        <!-- Icon with Badge -->
        <FrameLayout
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_gravity="center"
            android:layout_marginTop="@dimen/_8sdp"
            android:layout_marginBottom="@dimen/_16sdp">

            <!-- Main Icon Circle -->
            <FrameLayout
                android:layout_width="@dimen/_70sdp"
                android:layout_height="@dimen/_70sdp"
                android:background="@drawable/bg_draft_icon_circle">

                <ImageView
                    android:id="@+id/ivDraftIcon"
                    android:layout_width="@dimen/_40sdp"
                    android:layout_height="@dimen/_40sdp"
                    android:layout_gravity="center"
                    android:src="@drawable/baseline_draft_24"
                    app:tint="@color/white" />
            </FrameLayout>

            <!-- Count Badge -->
            <TextView
                android:id="@+id/tvDraftCount"
                android:layout_width="@dimen/_28sdp"
                android:layout_height="@dimen/_28sdp"
                android:layout_gravity="top|end"
                android:background="@drawable/bg_count_badge"
                android:gravity="center"
                android:text="5"
                android:textColor="@color/white"
                android:textSize="@dimen/_12sdp"
                android:fontFamily="@font/roboto_bold" />
        </FrameLayout>

        <!-- Title -->
        <TextView
            android:id="@+id/tvDraftTitle"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_gravity="center"
            android:text="@string/pending_draft_hai"
            android:textSize="@dimen/_12sdp"
            android:textColor="@color/black"
            android:fontFamily="@font/roboto_bold"
            android:layout_marginBottom="@dimen/_6sdp" />

        <!-- Message -->
        <TextView
            android:id="@+id/tvDraftMessage"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_gravity="center"
            android:text="@string/tumhara_pending_data_idhar_hai"
            android:textSize="@dimen/_10sdp"
            android:textColor="#666666"
            android:fontFamily="@font/roboto_regular"
            android:gravity="center"
            android:layout_marginBottom="@dimen/_20sdp" />

        <!-- Decorative Divider -->
        <View
            android:layout_width="@dimen/_50sdp"
            android:layout_height="@dimen/_3sdp"
            android:layout_gravity="center"
            android:background="@drawable/bg_divider_gradient"
            android:layout_marginBottom="@dimen/_20sdp" />

        <!-- Action Buttons -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center"
            android:weightSum="2">

            <!-- No Button -->
            <com.google.android.material.button.MaterialButton
                android:id="@+id/btnDraftNo"
                android:layout_width="0dp"
                android:layout_height="@dimen/_48sdp"
                android:layout_weight="1"
                android:layout_marginEnd="@dimen/_6sdp"
                android:text="@string/nahi_baad_me"
                android:textColor="#666666"
                android:textSize="@dimen/_12sdp"
                android:fontFamily="@font/roboto_bold"
                android:maxLines="1"
                android:ellipsize="end"
                style="@style/Widget.MaterialComponents.Button.OutlinedButton"
                app:strokeColor="#CCCCCC"
                app:strokeWidth="2dp"
                app:cornerRadius="@dimen/_12sdp"
                app:iconTint="#666666"
                app:iconGravity="textStart"
                app:iconSize="@dimen/_18sdp" />

            <!-- Yes Button -->
            <com.google.android.material.button.MaterialButton
                android:id="@+id/btnDraftYes"
                android:layout_width="0dp"
                android:layout_height="@dimen/_48sdp"
                android:layout_weight="1"
                android:layout_marginStart="@dimen/_6sdp"
                android:text="@string/haan_dekhte_hain"
                android:textColor="@color/white"
                android:textSize="@dimen/_12sdp"
                android:fontFamily="@font/roboto_bold"
                android:maxLines="1"
                android:ellipsize="end"
                android:backgroundTint="@color/green"
                app:cornerRadius="@dimen/_12sdp"
                app:iconTint="@color/white"
                app:iconGravity="textStart"
                app:iconSize="@dimen/_18sdp" />
        </LinearLayout>

        <!-- Bottom Hint -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center"
            android:layout_marginTop="@dimen/_14sdp"
            android:layout_marginBottom="@dimen/_8sdp"
            android:padding="@dimen/_10sdp"
            android:background="@drawable/bg_hint_box">

            <ImageView
                android:layout_width="@dimen/_16sdp"
                android:layout_height="@dimen/_16sdp"
                android:src="@drawable/baseline_info_24"
                app:tint="@color/color_primary" />

            <TextView
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:layout_marginStart="@dimen/_6sdp"
                android:text="@string/draft_complete_kar_lo"
                android:textSize="@dimen/_10sdp"
                android:textColor="@color/color_primary"
                android:fontFamily="@font/roboto_medium" />
        </LinearLayout>

    </LinearLayout>

</ScrollView>