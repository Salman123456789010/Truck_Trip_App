<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:fillViewport="true">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="@dimen/_16sdp"
        android:background="@color/white">

        <TextView
            android:id="@+id/title"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="@string/add_fuel"
            android:textSize="@dimen/_18sdp"
            android:textStyle="bold"
            android:textColor="@color/black"
            android:paddingBottom="@dimen/_10sdp"
            android:fontFamily="@font/roboto_medium" />

        <!-- Diesel Liters Field (Required) -->
        <com.google.android.material.textfield.TextInputLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/_10sdp"
            app:boxStrokeColor="@color/color_primary"
            app:hintEnabled="true"
            style="@style/Widget.MaterialComponents.TextInputLayout.OutlinedBox">

            <com.google.android.material.textfield.TextInputEditText
                android:id="@+id/etLiters"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:hint="@string/diesel_liters"
                android:inputType="numberDecimal"
                android:maxLength="9"
                android:textSize="@dimen/_14sdp" />

        </com.google.android.material.textfield.TextInputLayout>

        <!-- Amount Field (Required) -->
        <com.google.android.material.textfield.TextInputLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/_10sdp"
            app:boxStrokeColor="@color/color_primary"
            app:hintEnabled="true"
            style="@style/Widget.MaterialComponents.TextInputLayout.OutlinedBox">

            <com.google.android.material.textfield.TextInputEditText
                android:id="@+id/etAmount"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:hint="@string/amount_required"
                android:inputType="number"
                android:maxLength="9"
                android:textSize="@dimen/_14sdp" />

        </com.google.android.material.textfield.TextInputLayout>

        <!-- KM Input Type Selection -->
        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/_15sdp"
            android:text="@string/km_input_type"
            android:textSize="@dimen/_13sdp"
            android:textColor="@color/black"
            android:fontFamily="@font/roboto_medium" />

        <RadioGroup
            android:id="@+id/rgKmInputType"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:layout_marginTop="@dimen/_8sdp">

            <RadioButton
                android:id="@+id/rbOdometer"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:text="@string/odometer_reading"
                android:textSize="@dimen/_13sdp"
                android:maxLines="1"
                android:checked="true"
                android:ellipsize="marquee"
                android:buttonTint="@color/color_primary" />

            <RadioButton
                android:id="@+id/rbDistance"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:text="@string/distance_traveled"
                android:textSize="@dimen/_13sdp"
                android:ellipsize="marquee"
                android:buttonTint="@color/color_primary" />

        </RadioGroup>

        <!-- KM Input Field (Changes based on selection) -->
        <com.google.android.material.textfield.TextInputLayout
            android:id="@+id/tilKm"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/_10sdp"
            app:boxStrokeColor="@color/color_primary"
            app:hintEnabled="true"
            style="@style/Widget.MaterialComponents.TextInputLayout.OutlinedBox">

            <com.google.android.material.textfield.TextInputEditText
                android:id="@+id/etKm"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:hint="@string/km_reading_odometer"
                android:inputType="number"
                android:maxLength="9"
                android:textSize="@dimen/_14sdp" />

        </com.google.android.material.textfield.TextInputLayout>

        <!-- Calculated Average Display (Optional) -->
        <LinearLayout
            android:id="@+id/llAverageDisplay"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/_8sdp"
            android:orientation="horizontal"
            android:visibility="gone"
            android:padding="@dimen/_8sdp"
            android:background="@drawable/bg_light_primary">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/fuel_average"
                android:textSize="@dimen/_12sdp"
                android:textColor="@color/black" />

            <TextView
                android:id="@+id/tvAverageValue"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:gravity="end"
                android:textSize="@dimen/_13sdp"
                android:textStyle="bold"
                android:textColor="@color/color_primary"
                android:fontFamily="@font/roboto_medium" />

        </LinearLayout>

        <!-- Place / Pump Field (Optional) -->
        <com.google.android.material.textfield.TextInputLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/_10sdp"
            app:boxStrokeColor="@color/color_primary"
            app:hintEnabled="true"
            style="@style/Widget.MaterialComponents.TextInputLayout.OutlinedBox">

            <com.google.android.material.textfield.TextInputEditText
                android:id="@+id/etPlace"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:hint="@string/place_pump"
                android:inputType="text"
                android:textSize="@dimen/_14sdp" />

        </com.google.android.material.textfield.TextInputLayout>

        <!-- Date Field -->
        <com.google.android.material.textfield.TextInputLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/_10sdp"
            app:boxStrokeColor="@color/color_primary"
            app:hintEnabled="true"
            style="@style/Widget.MaterialComponents.TextInputLayout.OutlinedBox">

            <com.google.android.material.textfield.TextInputEditText
                android:id="@+id/etDate"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:hint="@string/date"
                android:inputType="none"
                android:focusable="false"
                android:clickable="true"
                android:textSize="@dimen/_14sdp" />

        </com.google.android.material.textfield.TextInputLayout>

        <!-- Save Button -->
        <androidx.cardview.widget.CardView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/_20sdp"
            android:layout_marginBottom="@dimen/_10sdp"
            app:cardBackgroundColor="@color/color_primary"
            app:cardCornerRadius="@dimen/_10sdp">

            <TextView
                android:id="@+id/btnSave"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:fontFamily="@font/roboto_medium"
                android:padding="@dimen/_12sdp"
                android:gravity="center"
                android:textColor="@color/white"
                android:text="@string/save"
                android:textSize="@dimen/_16sdp" />

        </androidx.cardview.widget.CardView>

    </LinearLayout>

</ScrollView>